# ---- OpenAI (scope extraction + SKU matching) ----
OPENAI_API_KEY=sk-...
# Model used for extraction. Default is cost-optimized; bump to gpt-4o for max accuracy.
OPENAI_MODEL=gpt-4o-mini

# ---- Supabase (Postgres, system of record) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Server-only. Never expose to the browser. Used by API routes for writes.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Telegram (real external integration: notify Marcus + approve) ----
# Create a bot with @BotFather, paste the token here.
TELEGRAM_BOT_TOKEN=123456:ABC...
# Chat ID that receives quote-ready pings (Marcus). Get it from @userinfobot.
TELEGRAM_CHAT_ID=123456789
# Shared secret in the Telegram webhook URL so only Telegram can call it.
TELEGRAM_WEBHOOK_SECRET=some-long-random-string

# ---- App ----
# Public base URL of the deployed app (used in Telegram deep links).
NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app

# ---- GoHighLevel (client system of record) ----
# No creds available for the take-home; the GHL adapter runs in mock mode
# unless these are set. Production target is the real GHL API.
GHL_API_KEY=
GHL_LOCATION_ID=
